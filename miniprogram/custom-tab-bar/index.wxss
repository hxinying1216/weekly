.tab-bar {
  display: flex;
  box-sizing: border-box;
  min-height: 124rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-shadow: 0 -1rpx 0 #e7eaf0;
}

.tab-item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 76rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  color: #7d899d;
  font-size: 24rpx;
  line-height: 1.3;
  text-align: center;
  transition: background-color 180ms ease-out, color 180ms ease-out, box-shadow 180ms ease-out;
}

.tab-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-item-active {
  background: #edf4ff;
  box-shadow: 0 4rpx 8rpx rgba(37, 99, 235, 0.14);
  color: #2563eb;
  font-weight: 650;
}

.tab-item:active {
  background: #e7edf7;
  color: #2563eb;
}

.tab-item-active:active {
  background: #dfeaff;
}
