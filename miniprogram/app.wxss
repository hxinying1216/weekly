page {
  min-height: 100%;
  background: #f7f8fa;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.container {
  box-sizing: border-box;
  width: 100%;
  max-width: 1480rpx;
  margin: 0 auto;
  padding: 32rpx 28rpx 120rpx;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.eyebrow {
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page-title {
  display: block;
  margin-top: 8rpx;
  color: #172033;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-description {
  display: block;
  margin-top: 12rpx;
  color: #697386;
  font-size: 26rpx;
  line-height: 1.55;
}

.status-chip {
  flex: none;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #2563eb;
  font-size: 22rpx;
}

.surface {
  border: 1rpx solid #e7eaf0;
  border-radius: 20rpx;
  background: #ffffff;
}

.section-title {
  display: block;
  color: #172033;
  font-size: 30rpx;
  font-weight: 650;
}

.muted {
  color: #8a94a6;
}

.placeholder {
  padding: 48rpx 32rpx;
  text-align: center;
}

.placeholder-title {
  display: block;
  margin-bottom: 12rpx;
  color: #4b5565;
  font-size: 30rpx;
  font-weight: 600;
}

.placeholder-text {
  display: block;
  color: #8a94a6;
  font-size: 26rpx;
  line-height: 1.6;
}

@media (min-width: 960px) {
  .container {
    padding: 52rpx 56rpx 72rpx;
  }

  .page-title {
    font-size: 52rpx;
  }
}
