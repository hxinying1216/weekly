.task-board {
  overflow: hidden;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.board-hint {
  color: #8a94a6;
  font-size: 24rpx;
}

.board-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-trigger,
.delete-button,
.dialog-close,
.cancel-button,
.confirm-button {
  margin: 0;
  border: 0;
  line-height: normal;
}

.add-trigger::after,
.delete-button::after,
.dialog-close::after,
.cancel-button::after,
.confirm-button::after {
  border: 0;
}

.add-trigger {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #edf4ff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.add-icon {
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
}

.task-list {
  padding: 0 32rpx;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 112rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-title {
  display: block;
  color: #273247;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.task-note {
  display: block;
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.delete-button {
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 64rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: 10rpx;
  background: #fff1f2;
  color: #dc2626;
  font-size: 24rpx;
  line-height: 64rpx;
}

.dialog-mask {
  position: fixed;
  z-index: 99;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  background: rgba(23, 32, 51, 0.46);
  box-sizing: border-box;
}

.add-dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 640rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.dialog-close {
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 50%;
  background: #f4f5f7;
  color: #697386;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 50rpx;
}

.field-group {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #4b5565;
  font-size: 24rpx;
  font-weight: 600;
}

.field-input,
.field-note {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #d9dee8;
  border-radius: 12rpx;
  background: #f9fafb;
  color: #172033;
  font-size: 26rpx;
  line-height: 1.5;
}

.field-input {
  height: 80rpx;
  padding-top: 0;
  padding-bottom: 0;
}

.field-note {
  min-height: 136rpx;
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 36rpx;
}

.cancel-button,
.confirm-button {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.cancel-button {
  background: #f4f5f7;
  color: #697386;
}

.confirm-button {
  background: #2563eb;
  color: #ffffff;
  font-weight: 600;
}

@media (min-width: 960px) {
  .task-board {
    max-width: 1160rpx;
  }

  .add-dialog {
    max-width: 720rpx;
  }
}
