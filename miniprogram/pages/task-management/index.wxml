<view class="container {{pageTransition}}">
  <view class="surface task-board">
    <view class="section-head">
      <text class="section-title">项目管理</text>
      <view class="board-tools">
        <text class="board-hint">已持久化</text>
        <button class="add-trigger" bindtap="openAddDialog" aria-label="添加任务">
          <text class="add-icon">＋</text>
          <text>添加任务</text>
        </button>
      </view>
    </view>

    <view wx:if="{{isLoading}}" class="placeholder">
      <text class="placeholder-text">正在加载任务…</text>
    </view>

    <view wx:elif="{{projects.length}}" class="task-list">
      <view wx:for="{{projects}}" wx:key="id" class="task-row">
        <view class="task-content">
          <text class="task-title">{{item.title}}（创建人：{{item.creator}}）</text>
          <text wx:if="{{item.note}}" class="task-note">项目备注：{{item.note}}</text>
        </view>
        <button class="delete-button" data-id="{{item.id}}" bindtap="deleteTask">删除</button>
      </view>
    </view>

    <view wx:else class="placeholder">
      <text class="placeholder-title">还没有项目任务</text>
      <text class="placeholder-text">点击右上角添加任务，即可创建第一个可分配的项目。</text>
    </view>
  </view>

  <view wx:if="{{isAddDialogVisible}}" class="dialog-mask" bindtap="closeAddDialog">
    <view class="add-dialog" catchtap="stopDialogTap">
      <view class="dialog-header">
        <text class="section-title">添加任务</text>
        <view class="dialog-close" role="button" aria-label="关闭" bindtap="closeAddDialog">×</view>
      </view>
      <view class="field-group">
        <text class="field-label">任务名称</text>
        <input
          class="field-input"
          placeholder="例如：整理项目需求"
          value="{{draftTitle}}"
          maxlength="80"
          focus
          bindinput="onTitleInput"
          confirm-type="done"
          bindconfirm="addTask"
        />
      </view>
      <view class="field-group">
        <text class="field-label">任务备注</text>
        <textarea
          class="field-note"
          placeholder="可选，补充任务说明"
          value="{{draftNote}}"
          maxlength="300"
          auto-height
          bindinput="onNoteInput"
        />
      </view>
      <view class="dialog-actions">
        <button class="cancel-button" bindtap="closeAddDialog" disabled="{{isSaving}}">取消</button>
        <button class="confirm-button" bindtap="addTask" loading="{{isSaving}}" disabled="{{isSaving}}">{{isSaving ? '创建中' : '添加'}}</button>
      </view>
    </view>
  </view>
</view>
