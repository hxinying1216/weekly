<view class="container {{pageTransition}}">
  <view class="surface archive-content">
    <view class="section-head">
      <view>
        <text class="section-title">任务归档</text>
        <text class="archive-hint">按完成日期查询</text>
      </view>
      <text class="archive-count">共 {{subtaskCountText}} 项</text>
    </view>

    <view class="archive-filters">
      <view class="date-selectors">
        <picker mode="date" value="{{startDate}}" start="{{minimumDate}}" end="{{maximumDate}}" bindchange="onStartDateChange">
          <view class="date-field">
            <text class="date-label">开始日期</text>
            <text class="date-value">{{startDateLabel}}</text>
          </view>
        </picker>
        <text class="date-divider">至</text>
        <picker mode="date" value="{{endDate}}" start="{{minimumDate}}" end="{{maximumDate}}" bindchange="onEndDateChange">
          <view class="date-field">
            <text class="date-label">结束日期</text>
            <text class="date-value">{{endDateLabel}}</text>
          </view>
        </picker>
      </view>
      <picker wx:if="{{isUserFilterVisible}}" class="member-picker" range="{{memberNames}}" value="{{selectedMemberIndex}}" bindchange="onUserChange">
        <view class="member-field">
          <text class="member-label">完成用户</text>
          <text class="member-value">{{selectedMemberName}}</text>
        </view>
      </picker>
    </view>

    <view wx:if="{{isLoading}}" class="placeholder">
      <text class="placeholder-text">正在加载归档任务…</text>
    </view>

    <view wx:elif="{{projects.length}}" class="project-list">
      <view wx:for="{{projects}}" wx:key="id" class="project-card" data-id="{{item.id}}" bindtap="openProjectDialog">
        <view class="project-title-line">
          <text class="task-title">{{item.title}}（创建人：{{item.creator}}）</text>
          <text class="project-count">{{item.subtaskCountText}} 项</text>
        </view>
        <text class="project-note">项目备注：{{item.note}}</text>
      </view>
    </view>

    <view wx:else class="placeholder">
      <text class="placeholder-title">当前日期范围暂无归档任务</text>
      <text class="placeholder-text">完成任务后，会按完成日期显示在这里。</text>
    </view>
  </view>

  <view wx:if="{{isProjectDialogVisible}}" class="dialog-mask" bindtap="closeProjectDialog">
    <view class="project-dialog" catchtap="stopDialogTap">
      <view class="dialog-header">
        <text class="section-title">{{selectedProject.title}}</text>
        <view class="dialog-close" role="button" aria-label="关闭" bindtap="closeProjectDialog">×</view>
      </view>
      <text class="dialog-project-note">项目备注：{{selectedProject.note}}</text>
      <view class="dialog-subtask-list">
        <view wx:for="{{selectedProject.subtasks}}" wx:key="id" class="subtask-unit">
          <text class="subtask-note">个人备注：{{item.note}}</text>
          <view class="subtask-meta">
            <text>接取人：{{item.assignee}}</text>
            <text>完成：{{item.completedDateLabel}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
