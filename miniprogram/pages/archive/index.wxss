.archive-content {
  overflow: hidden;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.archive-hint {
  display: block;
  margin-top: 8rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.archive-count {
  flex: none;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
}

.archive-filters {
  padding: 20rpx 32rpx 28rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.date-selectors {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.date-selectors picker {
  flex: 1;
  min-width: 0;
}

.date-field {
  box-sizing: border-box;
  height: 78rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid #e0e5ed;
  border-radius: 14rpx;
  background: #f9fafb;
}

.date-label,
.date-value {
  display: block;
}

.date-label {
  color: #8a94a6;
  font-size: 19rpx;
}

.date-value {
  margin-top: 4rpx;
  overflow: hidden;
  color: #273247;
  font-size: 22rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-divider {
  flex: none;
  color: #8a94a6;
  font-size: 20rpx;
}

.member-picker {
  display: block;
  margin-top: 16rpx;
}

.member-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e0e5ed;
  border-radius: 14rpx;
  background: #f9fafb;
}

.member-label {
  color: #8a94a6;
  font-size: 22rpx;
}

.member-value {
  color: #273247;
  font-size: 23rpx;
  font-weight: 600;
}

.project-list {
  padding: 24rpx 32rpx 32rpx;
}

.project-card {
  padding: 26rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 16rpx;
  background: #ffffff;
}

.project-card:active {
  background: #f7f9fc;
}

.project-card + .project-card {
  margin-top: 20rpx;
}

.project-title-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.project-title-line .task-title {
  flex: 1;
  min-width: 0;
}

.project-count {
  flex: none;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
}

.task-title,
.project-note,
.subtask-note {
  display: block;
  word-break: break-all;
}

.task-title {
  color: #273247;
  font-size: 28rpx;
  line-height: 1.5;
}

.project-note {
  margin-top: 8rpx;
  color: #697386;
  font-size: 24rpx;
  line-height: 1.5;
}

.subtask-list {
  margin-top: 20rpx;
}

.subtask-unit {
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f7f9fc;
}

.subtask-unit + .subtask-unit {
  margin-top: 12rpx;
}

.subtask-note {
  color: #4b5565;
  font-size: 24rpx;
  line-height: 1.5;
}

.subtask-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 10rpx;
  color: #8a94a6;
  font-size: 22rpx;
  line-height: 1.5;
}

.dialog-mask {
  position: fixed;
  z-index: 99;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 36rpx;
  background: rgba(23, 32, 51, 0.46);
}

.project-dialog {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 640rpx;
  max-height: 80vh;
  padding: 32rpx;
  overflow-y: auto;
  border-radius: 20rpx;
  background: #ffffff;
}

.dialog-header {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding-right: 64rpx;
}

.dialog-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid #cfe0ff;
  border-radius: 50%;
  background: #eef4ff;
  color: #2563eb;
  font-size: 34rpx;
  line-height: 1;
}

.dialog-project-note {
  display: block;
  margin-top: 16rpx;
  color: #697386;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.dialog-subtask-list {
  margin-top: 24rpx;
}

@media (min-width: 960px) {
  .archive-content {
    max-width: 1160rpx;
  }
}
