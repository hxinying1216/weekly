.archive-content {
  overflow: hidden;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.archive-hint {
  display: block;
  margin-top: 8rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.archive-count {
  flex: none;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
}

.archive-filters {
  padding: 20rpx 32rpx 28rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.date-selectors {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.date-selectors picker {
  flex: 1;
  min-width: 0;
}

.date-field {
  box-sizing: border-box;
  height: 78rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid #e0e5ed;
  border-radius: 14rpx;
  background: #f9fafb;
}

.date-label,
.date-value {
  display: block;
}

.date-label {
  color: #8a94a6;
  font-size: 19rpx;
}

.date-value {
  margin-top: 4rpx;
  overflow: hidden;
  color: #273247;
  font-size: 22rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-divider {
  flex: none;
  color: #8a94a6;
  font-size: 20rpx;
}

.project-list {
  padding: 24rpx 32rpx 32rpx;
}

.project-card {
  padding: 26rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 16rpx;
  background: #ffffff;
}

.project-card + .project-card {
  margin-top: 20rpx;
}

.task-title,
.project-note,
.subtask-note {
  display: block;
  word-break: break-all;
}

.task-title {
  color: #273247;
  font-size: 28rpx;
  line-height: 1.5;
}

.project-note {
  margin-top: 8rpx;
  color: #697386;
  font-size: 24rpx;
  line-height: 1.5;
}

.subtask-list {
  margin-top: 20rpx;
}

.subtask-unit {
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f7f9fc;
}

.subtask-unit + .subtask-unit {
  margin-top: 12rpx;
}

.subtask-note {
  color: #4b5565;
  font-size: 24rpx;
  line-height: 1.5;
}

.subtask-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 10rpx;
  color: #8a94a6;
  font-size: 22rpx;
  line-height: 1.5;
}

@media (min-width: 960px) {
  .archive-content {
    max-width: 1160rpx;
  }
}
