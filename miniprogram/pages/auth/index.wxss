.auth-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 120rpx 44rpx 64rpx;
  background: linear-gradient(155deg, #eff6ff 0%, #f7f8fa 48%, #ffffff 100%);
}

.brand-block {
  margin-bottom: 56rpx;
}

.brand-description {
  display: block;
  margin-top: 16rpx;
  color: #697386;
  font-size: 27rpx;
  line-height: 1.65;
}

.auth-card {
  overflow: hidden;
  border: 1rpx solid #e3e8f2;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 56rpx rgba(37, 99, 235, 0.08);
}

.auth-name {
  display: block;
  padding: 28rpx 32rpx 8rpx;
  color: #172033;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.mode-tabs {
  display: flex;
  padding: 10rpx 12rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.mode-tab {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 12rpx;
  color: #8a94a6;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.mode-tab.is-active {
  background: #edf4ff;
  color: #2563eb;
}

.form-body {
  padding: 36rpx 32rpx 40rpx;
}

.form-description, .role-tip {
  display: block;
  color: #8a94a6;
  font-size: 24rpx;
  line-height: 1.55;
}

.form-description {
  margin-top: 10rpx;
}

.field-group {
  margin-top: 28rpx;
}

.field-label {
  display: block;
  color: #4b5565;
  font-size: 24rpx;
  font-weight: 600;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d9dee8;
  border-radius: 12rpx;
  background: #f9fafb;
  color: #172033;
  font-size: 26rpx;
}

.primary-button {
  height: 84rpx;
  margin: 36rpx 0 0;
  border: 0;
  border-radius: 12rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.primary-button::after {
  border: 0;
}

.role-tip {
  margin-top: 22rpx;
  text-align: center;
}

@media (min-width: 960px) {
  .auth-page {
    width: 760rpx;
    margin: 0 auto;
    padding-top: 160rpx;
  }
}
