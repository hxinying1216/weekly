.profile-panel {
  overflow: hidden;
}

.security-panel {
  margin-top: 24rpx;
}

.section-head {
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.section-description {
  display: block;
  margin-top: 10rpx;
  color: #8a94a6;
  font-size: 24rpx;
  line-height: 1.5;
}

.form-body {
  padding: 12rpx 32rpx 32rpx;
}

.field-group {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  color: #4b5565;
  font-size: 24rpx;
  font-weight: 600;
}

.avatar-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-frame {
  position: relative;
  display: flex;
  flex: 0 0 96rpx;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  background: #dbeafe;
}

.avatar-picker {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.avatar-picker::after {
  border: 0;
}

.avatar-image {
  display: block;
  width: 96rpx;
  height: 96rpx;
}

.avatar-initial {
  color: #2563eb;
  font-size: 34rpx;
  font-weight: 600;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d9dee8;
  border-radius: 12rpx;
  background: #f9fafb;
  color: #172033;
  font-size: 26rpx;
}

.primary-button {
  height: 80rpx;
  margin: 32rpx 0 0;
  border: 0;
  border-radius: 12rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.primary-button::after {
  border: 0;
}

@media (min-width: 960px) {
  .profile-panel {
    max-width: 900rpx;
  }
}
