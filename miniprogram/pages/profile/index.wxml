<view class="container {{pageTransition}}">
  <view class="surface profile-panel">
    <view class="section-head">
      <view>
        <text class="section-title">基本资料</text>
        <text class="section-description">资料仅在当前会话中更新。</text>
      </view>
    </view>
    <view class="form-body">
      <view class="field-group avatar-field">
        <text class="field-label">头像</text>
        <view class="avatar-frame">
          <image wx:if="{{profile.avatarUrl}}" class="avatar-image" src="{{profile.avatarUrl}}" mode="aspectFill" binderror="onAvatarLoadError" />
          <text wx:else class="avatar-initial">{{profile.avatarInitial}}</text>
          <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="选择微信头像"></button>
        </view>
      </view>
      <view class="field-group">
        <text class="field-label">昵称</text>
        <input class="field-input" value="{{nicknameInput}}" maxlength="20" data-field="nicknameInput" bindinput="onInput" />
      </view>
      <view class="field-group">
        <text class="field-label">手机号</text>
        <input class="field-input" type="number" value="{{phoneInput}}" maxlength="11" data-field="phoneInput" bindinput="onInput" />
      </view>
      <button class="primary-button" bindtap="saveProfile">保存资料</button>
    </view>
  </view>

  <view wx:if="{{isAdmin}}" class="surface profile-panel management-panel">
    <view class="section-head management-heading">
      <view>
        <text class="section-title">用户管理</text>
        <text class="section-description">创建账号、调整角色或删除用户。</text>
      </view>
      <button class="create-user-button" bindtap="openCreateDialog">创建用户</button>
    </view>

    <view wx:if="{{isUsersLoading}}" class="placeholder">
      <text class="placeholder-text">正在加载用户…</text>
    </view>
    <view wx:elif="{{users.length}}" class="user-list">
      <view wx:for="{{users}}" wx:key="id" class="user-row">
        <view class="user-summary">
          <text class="user-name">{{item.username}}</text>
          <text class="role-chip {{item.role === 'ADMIN' ? 'role-admin' : 'role-user'}}">{{item.role === 'ADMIN' ? '管理员' : '普通用户'}}</text>
        </view>
        <view class="user-actions">
          <button
            class="role-button"
            data-id="{{item.id}}"
            data-role="{{item.role === 'ADMIN' ? 'USER' : 'ADMIN'}}"
            bindtap="changeUserRole"
            loading="{{operatingUserId === item.id}}"
          >{{item.role === 'ADMIN' ? '设为用户' : '设为管理员'}}</button>
          <button class="delete-user-button" data-id="{{item.id}}" data-username="{{item.username}}" bindtap="deleteManagedUser">删除</button>
        </view>
      </view>
    </view>
    <view wx:else class="placeholder">
      <text class="placeholder-title">暂无用户</text>
      <text class="placeholder-text">点击“创建用户”添加第一个账号。</text>
    </view>
  </view>

  <view class="surface profile-panel security-panel">
    <view class="section-head">
      <text class="section-title">当前账号</text>
      <text class="section-description">当前角色：{{userRole}}。{{accessScope}}</text>
    </view>
    <view class="account-actions">
      <button class="logout-button" bindtap="logout">退出登录</button>
    </view>
  </view>

  <view wx:if="{{isCreateDialogVisible}}" class="dialog-mask" bindtap="closeCreateDialog">
    <view class="user-dialog" catchtap="stopDialogTap">
      <view class="dialog-header">
        <text class="section-title">创建用户</text>
        <button class="dialog-close" bindtap="closeCreateDialog" aria-label="关闭">×</button>
      </view>
      <view class="form-body dialog-body">
        <view class="field-group">
          <text class="field-label">用户名</text>
          <input class="field-input" value="{{createUsername}}" data-field="createUsername" bindinput="onInput" placeholder="3 至 32 位字母、数字或符号" maxlength="32" />
        </view>
        <view class="field-group">
          <text class="field-label">密码</text>
          <input class="field-input" password value="{{createPassword}}" data-field="createPassword" bindinput="onInput" placeholder="至少 6 位" maxlength="72" />
        </view>
        <view class="field-group">
          <text class="field-label">角色</text>
          <view class="role-select">
            <button class="role-option {{createRole === 'USER' ? 'role-option-active' : ''}}" data-role="USER" bindtap="selectCreateRole">普通用户</button>
            <button class="role-option {{createRole === 'ADMIN' ? 'role-option-active' : ''}}" data-role="ADMIN" bindtap="selectCreateRole">管理员</button>
          </view>
        </view>
        <view class="dialog-actions">
          <button class="cancel-button" bindtap="closeCreateDialog">取消</button>
          <button class="confirm-button" loading="{{operatingUserId === 'create'}}" bindtap="submitCreateUser">创建</button>
        </view>
      </view>
    </view>
  </view>
</view>
