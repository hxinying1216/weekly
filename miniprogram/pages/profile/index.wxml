<view class="container {{pageTransition}}">
  <view class="surface profile-panel">
    <view class="section-head">
      <view>
        <text class="section-title">基本资料</text>
        <text class="section-description">资料仅在当前会话中更新。</text>
      </view>
    </view>
    <view class="form-body">
      <view class="field-group avatar-field">
        <text class="field-label">头像</text>
        <view class="avatar-frame">
          <image wx:if="{{profile.avatarUrl}}" class="avatar-image" src="{{profile.avatarUrl}}" mode="aspectFill" binderror="onAvatarLoadError" />
          <text wx:else class="avatar-initial">{{profile.avatarInitial}}</text>
          <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" aria-label="选择微信头像"></button>
        </view>
      </view>
      <view class="field-group">
        <text class="field-label">昵称</text>
        <input class="field-input" value="{{nicknameInput}}" maxlength="20" data-field="nicknameInput" bindinput="onInput" />
      </view>
      <view class="field-group">
        <text class="field-label">手机号</text>
        <input class="field-input" type="number" value="{{phoneInput}}" maxlength="11" data-field="phoneInput" bindinput="onInput" />
      </view>
      <button class="primary-button" bindtap="saveProfile">保存资料</button>
    </view>
  </view>

  <view class="surface profile-panel security-panel">
    <view class="section-head">
      <text class="section-title">账号登录</text>
      <text class="section-description">本小程序将使用微信账号完成身份识别和登录，无需设置或修改独立密码。</text>
    </view>
  </view>
</view>
