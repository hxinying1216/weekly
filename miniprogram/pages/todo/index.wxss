.date-panel,
.focus-panel {
  overflow: hidden;
}

.date-panel {
  padding: 30rpx 32rpx;
}

.range-selectors {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.range-selectors picker {
  flex: 1;
  min-width: 0;
}

.range-field {
  box-sizing: border-box;
  min-height: 116rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e5ed;
  border-radius: 14rpx;
  background: #f9fafb;
}

.range-label,
.range-value,
.range-hint {
  display: block;
}

.range-label {
  color: #8a94a6;
  font-size: 22rpx;
}

.range-value {
  margin-top: 10rpx;
  overflow: hidden;
  color: #273247;
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.range-divider {
  flex: none;
  color: #8a94a6;
  font-size: 24rpx;
}

.range-hint {
  margin-top: 18rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.focus-panel {
  margin-top: 24rpx;
}

.focus-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.focus-title-area {
  flex: 1;
  min-width: 0;
}

.inline-range-selectors {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.inline-range-selectors picker {
  flex: 1;
  min-width: 0;
}

.inline-range-field {
  box-sizing: border-box;
  min-width: 0;
  height: 78rpx;
  padding: 10rpx 14rpx;
  overflow: hidden;
  border: 1rpx solid #e0e5ed;
  border-radius: 12rpx;
  background: #f9fafb;
}

.inline-range-field .range-label,
.inline-range-field .range-value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inline-range-field .range-label {
  font-size: 19rpx;
}

.inline-range-field .range-value {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.inline-range-selectors .range-divider {
  font-size: 20rpx;
}

.add-trigger,
.dialog-close,
.cancel-button,
.confirm-button {
  margin: 0;
  border: 0;
  line-height: normal;
}

.add-trigger::after,
.dialog-close::after,
.cancel-button::after,
.confirm-button::after {
  border: 0;
}

.add-trigger {
  display: flex;
  flex: none;
  align-self: flex-end;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  margin-left: 16rpx;
  padding: 0;
  border: 1rpx solid #e0e5ed;
  border-radius: 12rpx;
  background: #f9fafb;
  color: #697386;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 56rpx;
}

.add-trigger:active {
  background: #edf4ff;
  color: #2563eb;
}

.add-icon {
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
}

.task-list {
  padding: 0 32rpx;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 112rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-title,
.task-note {
  display: block;
  word-break: break-all;
}

.task-title {
  color: #273247;
  font-size: 28rpx;
  line-height: 1.5;
}

.task-note {
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 24rpx;
  line-height: 1.5;
}

.task-date {
  flex: none;
  color: #697386;
  font-size: 22rpx;
}

.dialog-mask {
  position: fixed;
  z-index: 99;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 36rpx;
  background: rgba(23, 32, 51, 0.46);
}

.add-dialog {
  box-sizing: border-box;
  width: 100%;
  max-width: 640rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.dialog-close {
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 50%;
  background: #f4f5f7;
  color: #697386;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 50rpx;
}

.field-group {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #4b5565;
  font-size: 24rpx;
  font-weight: 600;
}

.field-input,
.field-note,
.date-picker-value {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #d9dee8;
  border-radius: 12rpx;
  background: #f9fafb;
  color: #172033;
  font-size: 26rpx;
  line-height: 1.5;
}

.field-input,
.date-picker-value {
  height: 80rpx;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 80rpx;
}

.field-note {
  min-height: 136rpx;
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 36rpx;
}

.cancel-button,
.confirm-button {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}

.cancel-button {
  background: #f4f5f7;
  color: #697386;
}

.confirm-button {
  background: #2563eb;
  color: #ffffff;
  font-weight: 600;
}

@media (min-width: 960px) {
  .date-panel,
  .focus-panel {
    max-width: 1160rpx;
  }

  .range-selectors {
    max-width: 760rpx;
  }

  .add-dialog {
    max-width: 720rpx;
  }
}
