.date-panel,
.focus-panel {
  overflow: hidden;
}

.date-panel {
  padding: 30rpx 32rpx;
}

.range-selectors {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.range-selectors picker {
  flex: 1;
  min-width: 0;
}

.range-field {
  box-sizing: border-box;
  min-height: 116rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e5ed;
  border-radius: 14rpx;
  background: #f9fafb;
}

.range-label,
.range-value,
.range-hint {
  display: block;
}

.range-label {
  color: #8a94a6;
  font-size: 22rpx;
}

.range-value {
  margin-top: 10rpx;
  overflow: hidden;
  color: #273247;
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.range-divider {
  flex: none;
  color: #8a94a6;
  font-size: 24rpx;
}

.range-hint {
  margin-top: 18rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.focus-panel {
  margin-top: 24rpx;
}

.focus-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.focus-subtitle,
.count-mark {
  display: block;
  margin-top: 10rpx;
  color: #8a94a6;
  font-size: 24rpx;
}

.focus-title-area {
  flex: 1;
  min-width: 0;
}

.focus-title-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.filter-controls {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.filter-group {
  min-width: 0;
}

.date-filter {
  flex: 1;
}

.user-filter {
  flex: none;
  width: 160rpx;
}

.filter-label {
  display: block;
  margin-bottom: 12rpx;
  color: #4b5565;
  font-size: 24rpx;
  font-weight: 600;
}

.date-selectors {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.date-selectors picker {
  flex: 1;
  min-width: 0;
}

.date-field,
.user-picker-value {
  box-sizing: border-box;
  border: 1rpx solid #e0e5ed;
  border-radius: 14rpx;
  background: #f9fafb;
}

.date-field {
  height: 78rpx;
  padding: 10rpx 14rpx;
}

.date-label,
.date-value {
  display: block;
}

.date-label {
  color: #8a94a6;
  font-size: 19rpx;
}

.date-value {
  margin-top: 4rpx;
  overflow: hidden;
  color: #273247;
  font-size: 22rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-divider {
  flex: none;
  color: #8a94a6;
  font-size: 20rpx;
}

.user-picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 78rpx;
  padding: 0 14rpx;
  color: #273247;
  font-size: 26rpx;
}

.project-list {
  padding: 24rpx 32rpx 32rpx;
}

.project-card {
  padding: 26rpx;
  border: 1rpx solid #e7eaf0;
  border-radius: 16rpx;
  background: #ffffff;
}

.project-card:active {
  background: #f7f9fc;
}

.project-card + .project-card {
  margin-top: 20rpx;
}

.project-title-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.project-title-line .task-title {
  flex: 1;
  min-width: 0;
}

.project-count {
  flex: none;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
}

.project-note {
  display: block;
  margin-top: 8rpx;
  color: #697386;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.subtask-list {
  margin-top: 20rpx;
}

.subtask-unit {
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f7f9fc;
}

.subtask-unit + .subtask-unit {
  margin-top: 12rpx;
}

.subtask-note {
  display: block;
  color: #4b5565;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.subtask-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 10rpx;
  color: #8a94a6;
  font-size: 22rpx;
  line-height: 1.5;
}

.dialog-mask {
  position: fixed;
  z-index: 99;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 36rpx;
  background: rgba(23, 32, 51, 0.46);
}

.project-dialog {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 640rpx;
  max-height: 80vh;
  padding: 32rpx;
  overflow-y: auto;
  border-radius: 20rpx;
  background: #ffffff;
}

.dialog-header {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding-right: 64rpx;
}

.dialog-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid #cfe0ff;
  border-radius: 50%;
  background: #eef4ff;
  color: #2563eb;
  font-size: 34rpx;
  line-height: 1;
}

.dialog-project-note {
  display: block;
  margin-top: 16rpx;
  color: #697386;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.dialog-subtask-list {
  margin-top: 24rpx;
}

.task-list {
  padding: 0 32rpx;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 128rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-title,
.task-note,
.task-assignee {
  display: block;
  word-break: break-all;
}

.task-title {
  color: #273247;
  font-size: 28rpx;
  line-height: 1.5;
}

.task-note,
.task-assignee {
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 24rpx;
  line-height: 1.5;
}

.task-date {
  flex: none;
  color: #697386;
  font-size: 22rpx;
}

.inline-range-selectors {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
}

.inline-range-selectors picker {
  flex: 1;
  min-width: 0;
}

.inline-range-field {
  box-sizing: border-box;
  min-width: 0;
  height: 70rpx;
  padding: 8rpx 10rpx;
  overflow: hidden;
  border: 1rpx solid #e0e5ed;
  border-radius: 12rpx;
  background: #f9fafb;
}

.inline-range-field .range-label,
.inline-range-field .range-value {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inline-range-field .range-label {
  font-size: 18rpx;
}

.inline-range-field .range-value {
  margin-top: 2rpx;
  font-size: 21rpx;
}

.inline-range-selectors .range-divider {
  font-size: 20rpx;
}

.count-mark {
  flex: none;
  margin: 0;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
}

@media (min-width: 960px) {
  .date-panel,
  .focus-panel {
    max-width: 1160rpx;
  }

  .range-selectors {
    max-width: 760rpx;
  }
}
